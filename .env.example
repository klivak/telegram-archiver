# Telegram Archiver - optional environment configuration.
# Copy to `.env` (repo root or backend/) and fill in. `.env` is git-ignored - never commit it.
# Everything here is OPTIONAL: normally you enter these in the UI and they are stored in the OS keyring (Windows Credential Manager). Env values are only used as a fallback when the keyring has no value.

# --- Telegram API (https://my.telegram.org -> API development tools) ---
TGARCHIVER_API_ID=
TGARCHIVER_API_HASH=

# Telethon StringSession (only for headless/CI setups; treat like a password - it grants full account access)
TGARCHIVER_SESSION=

# --- AI digests (only the provider you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# --- App ---
# Data dir override (config, DB, logs). Default: %APPDATA%\TelegramArchiver
TGARCHIVER_HOME=
# Archive folder used on first start (ignored once config.json exists)
TGARCHIVER_ARCHIVE_ROOT=
# Local server port (default 8765)
TGARCHIVER_PORT=
# Fixed UI/API token instead of a random one per launch
TGARCHIVER_TOKEN=
